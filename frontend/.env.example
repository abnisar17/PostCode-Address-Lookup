VITE_API_BASE_URL=http://localhost:8000
# Optional: API key sent as X-API-Key when the backend has REQUIRE_API_KEY=true.
# Baked into the client bundle at build time, so it is PUBLIC.
# In production we leave this EMPTY and let host nginx inject the website key
# for same-site requests (see deploy/nginx-api-key-inject.conf) so no key ships
# in the browser bundle. Set it only for local dev against an enforced backend.
VITE_API_KEY=
